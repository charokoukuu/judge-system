# This file is an example. Create a .env file with your actual values.

# -- Backend Environment Variables --

# PostgreSQL connection string
# This is used by Prisma and the Nest.js application inside the Docker container.
DATABASE_URL="postgresql://user:password@postgres:5432/debatedb?schema=public"

# OpenAI API Key for Speech-to-Text and Chat Completions
OPENAI_API_KEY="your-openai-api-key"

# Style-Bart TTS Server URL
STYLE_BART_API_URL="http://ec2-54-226-80-187.compute-1.amazonaws.com:8000/"


# -- Frontend Environment Variables --

# WebSocket URL for the Next.js frontend to connect to the backend
# This should be the address of your backend's WebSocket gateway.
# When running with Docker Compose, this will be localhost on the host machine.
NEXT_PUBLIC_WS_URL="ws://localhost:8080"
